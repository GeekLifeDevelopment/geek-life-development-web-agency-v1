---
export type FAQ = {
  question: string;
  answer: string;
};

interface Props {
  items?: FAQ[];
}

const {
  items = [
    {
      question: 'How long does a typical project take?',
      answer:
        'Most marketing websites launch in 3-6 weeks depending on scope, approvals, and whether copywriting is included.'
    },
    {
      question: 'Do you handle copy and messaging?',
      answer:
        'Yes. We can lead messaging strategy and page structure to ensure the website supports your sales process.'
    },
    {
      question: 'Can we start small and expand later?',
      answer:
        'Absolutely. We usually ship a focused first version, then iterate with new pages, experiments, and content.'
    }
  ]
} = Astro.props;
---

<div class="space-y-3" role="list">
  {
    items.map((item, index) => (
      <details
        role="listitem"
        class="group rounded-xl border border-slate-200/70 bg-white p-5 shadow-sm"
        open={index === 0}
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-medium text-slate-900 marker:content-none">
          <span>{item.question}</span>
          <span aria-hidden="true" class="text-slate-500 transition group-open:rotate-45">+</span>
        </summary>
        <div class="pt-3 text-sm leading-relaxed text-slate-600">
          {item.answer}
        </div>
      </details>
    ))
  }
</div>