---
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import type { HomepageSelectedWork } from '../../data/homepage';

interface Props {
  projects: HomepageSelectedWork[];
}

const { projects } = Astro.props;
---

<Section class="!py-16 md:!py-20">
  <div class="space-y-8">
    <Heading
      eyebrow="Recent work"
      title="Recent website work"
      subtitle="A couple examples of websites I've designed, rebuilt, and improved for small businesses and independent brands."
    />

    <div class="grid gap-5 lg:grid-cols-2">
      {
        projects.map((project) => {
          return (
            <Card class="relative min-h-[560px] overflow-hidden border-transparent p-0 md:min-h-[620px]">
              <img
                src={project.screenshot.src}
                alt={`${project.title} website screenshot`}
                class="absolute inset-0 h-full w-full object-cover object-top"
                loading="lazy"
              />

              <div class="absolute inset-x-0 bottom-0 z-10">
                <div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-t from-slate-950/45 to-transparent"></div>
                <div class="relative flex min-h-[240px] flex-col justify-end space-y-3 bg-slate-950/88 p-5 text-white [text-shadow:0_2px_10px_rgba(2,6,23,0.95)] md:min-h-[270px] md:p-6">
                  <div class="space-y-2">
                    <p class="label-mono text-white/85">{project.projectType}</p>
                    <h3 class="text-2xl font-semibold text-white">{project.title}</h3>
                    <p class="text-sm leading-relaxed text-white">{project.summary}</p>
                  </div>

                  <p class="text-sm leading-relaxed text-white/95">{project.details}</p>

                  <ul class="space-y-2 text-sm text-white/95">
                    {project.highlights.map((highlight) => <li>• {highlight}</li>)}
                  </ul>
                </div>
              </div>
            </Card>
          );
        })
      }
    </div>
  </div>
</Section>