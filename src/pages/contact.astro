---
import Layout from '../components/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import { siteConfig } from '../config/site';
---

<Layout
  title="Contact | Geek Life Development"
  description="Contact Geek Life Development to discuss your project goals, scope, and timeline. Serving Ozaukee County & the Milwaukee area + remote."
>
  <Section>
    <div class="max-w-4xl space-y-6">
      <h1 class="text-4xl md:text-6xl">Get a quote</h1>
      <p class="max-w-3xl text-base text-[var(--color-neutral)] md:text-lg">
        Reach out whichever way is easiest. Fill out the form, or call/text directly.
      </p>
      <p class="text-sm text-slate-600">
        Want to skip the form? <a href={siteConfig.phoneHref} class="font-semibold">Call or text {siteConfig.phoneDisplay}</a>.
      </p>
    </div>
  </Section>

  <Section class="bg-white" containerClass="max-w-6xl">
    <div class="grid items-start gap-6 lg:grid-cols-2">
      <Card hover={false} class="space-y-5">
        <p class="label-mono text-slate-500">Option 1</p>
        <h2 class="text-2xl">Call or text directly</h2>
        <p class="text-sm text-slate-600">Rather talk it through first? Reach me directly and we can quickly map the right next step.</p>
        <a href={siteConfig.phoneHref} class="inline-flex text-xl font-semibold leading-tight text-slate-900">
          {siteConfig.phoneDisplay}
        </a>
        <div class="space-y-2 text-sm text-slate-700">
          <p>• Call or text to talk through your project</p>
          <p>• No pressure, just a quick conversation</p>
          <p>• If form is easier, that works too</p>
        </div>
        <div class="flex flex-wrap gap-3 pt-2">
          <Button href={siteConfig.phoneHref}>Call now</Button>
          <Button href={`mailto:jason@geeklifedevelopment.com`} variant="secondary">Send email</Button>
        </div>
      </Card>

      <Card>
        <p class="label-mono text-slate-500">Option 2</p>
        <h2 class="mt-2 text-2xl">Fill out the project form</h2>

      <form
        id="contact-form"
        name="quote"
        method="POST"
        action="/contact/thanks"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-4 grid gap-5"
      >
        <input type="hidden" name="form-name" value="quote" />
        <p class="hidden">
          <label>
            Don’t fill this out if you’re human: <input name="bot-field" />
          </label>
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium text-slate-800">
            Name <span aria-hidden="true" class="text-[var(--color-primary)]">*</span>
            <input
              name="name"
              required
              autocomplete="name"
              placeholder="Your full name"
              class="h-11 rounded-lg border border-slate-200 px-3"
            />
          </label>

          <label class="grid gap-2 text-sm font-medium text-slate-800">
            Email <span aria-hidden="true" class="text-[var(--color-primary)]">*</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@company.com"
              class="h-11 rounded-lg border border-slate-200 px-3"
            />
          </label>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium text-slate-800">
            Company / Project name
            <input name="company" placeholder="Company or project" class="h-11 rounded-lg border border-slate-200 px-3" />
          </label>

          <label class="grid gap-2 text-sm font-medium text-slate-800">
            Location
            <input
              name="location"
              placeholder="Ozaukee County / Milwaukee / Remote"
              class="h-11 rounded-lg border border-slate-200 px-3"
            />
          </label>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium text-slate-800">
            Project type <span aria-hidden="true" class="text-[var(--color-primary)]">*</span>
            <select name="projectType" required class="h-11 rounded-lg border border-slate-200 bg-white px-3">
              <option value="">Select a project type</option>
              <option>Website</option>
              <option>Website + ongoing support</option>
              <option>Simple app / internal tool</option>
              <option>Not sure yet</option>
            </select>
          </label>

          <label class="grid gap-2 text-sm font-medium text-slate-800">
            Budget range <span aria-hidden="true" class="text-[var(--color-primary)]">*</span>
            <select
              name="budgetRange"
              required
              aria-describedby="budget-help"
              class="h-11 rounded-lg border border-slate-200 bg-white px-3"
            >
              <option value="">Select a budget range</option>
              <option>$1k–$3k</option>
              <option>$3k–$6k</option>
              <option>$6k–$10k</option>
              <option>$10k+</option>
              <option>Not sure yet</option>
            </select>
          </label>
        </div>

        <p id="budget-help" class="text-xs text-slate-600">This helps me recommend the right scope for your goals.</p>

        <label class="grid gap-2 text-sm font-medium text-slate-800">
          Timeline
          <select name="timeline" class="h-11 rounded-lg border border-slate-200 bg-white px-3">
            <option value="">Select a timeline</option>
            <option>ASAP</option>
            <option>2–4 weeks</option>
            <option>1–2 months</option>
            <option>Flexible</option>
          </select>
        </label>

        <label class="grid gap-2 text-sm font-medium text-slate-800">
          Message / Details <span aria-hidden="true" class="text-[var(--color-primary)]">*</span>
          <textarea
            name="message"
            rows={5}
            required
            aria-describedby="message-help"
            class="rounded-lg border border-slate-200 px-3 py-2"
            placeholder="What are you building, what problem are you trying to solve, and what timeline are you aiming for?"
          ></textarea>
        </label>

        <p id="message-help" class="text-xs text-slate-600">The more context you share, the better I can scope your request.</p>

        <div class="space-y-3">
          <Button type="submit" size="lg">Send request</Button>
          <p class="text-xs text-slate-600">
            No spam. I’ll only use this to reply about your request.
          </p>
        </div>
      </form>
      </Card>
    </div>

    <div class="mx-auto mt-10 max-w-3xl space-y-2 text-sm text-slate-600">
      <p>
        Prefer email?
        <a href="mailto:jason@geeklifedevelopment.com" class="font-medium">jason@geeklifedevelopment.com</a>
      </p>
      <p>
        Prefer to call?
        <a href={siteConfig.phoneHref} class="font-medium">{siteConfig.phoneDisplay}</a>
      </p>
      <p>Serving Ozaukee County & the Milwaukee area + remote.</p>
    </div>
  </Section>
</Layout>